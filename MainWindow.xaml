<Window x:Class="KyvoraPvp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KyvoraClient 26.2"
        Width="1360" Height="850" MinWidth="1020" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="xd/Kyvora-K.jpeg"
        Background="#090813"
        Foreground="#F4F5F8"
        FontFamily="Segoe UI">
  <Grid x:Name="RootLayout">
    <Grid.RowDefinitions>
      <RowDefinition Height="54" />
      <RowDefinition Height="28" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#0A0914" BorderBrush="#332044" BorderThickness="0,0,0,1">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="30" Height="30" CornerRadius="7" Background="#090C18"
                  BorderBrush="#B847FF" BorderThickness="1.5" ClipToBounds="True">
            <Image Source="xd/Kyvora-K.jpeg" Stretch="UniformToFill" />
          </Border>
          <TextBlock Text="KYVORA" FontSize="13" FontWeight="Bold" Foreground="#E7C1FF" Margin="9,0,0,0"
                     VerticalAlignment="Center" />
          <Border Background="#241034" BorderBrush="#8132B7" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="12,0,0,0">
            <TextBlock Text="CLIENT 26.2" FontSize="8" FontWeight="Bold" Foreground="#E3B1FF" />
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#171020" BorderBrush="#7435A0" BorderThickness="1"
                  CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
            <TextBlock x:Name="SelectedVersionText" Text="1.8.9" FontSize="9" Foreground="#E9C6FF" />
          </Border>
          <Button x:Name="AccountButton" Content="Vincular cuenta Microsoft"
                  Background="#251034" BorderBrush="#9742C9" BorderThickness="1" Padding="12,8" FontSize="9"
                  VerticalAlignment="Center" Click="AccountButton_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#24102D" BorderBrush="#762B91" BorderThickness="0,0,0,1">
      <TextBlock x:Name="LauncherTagline" Text="✦  KYVORA 26.2  ·  CLIENTE PVP PARA MINECRAFT 1.8.9"
                 FontSize="8" FontWeight="SemiBold" Foreground="#E9B7FF"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="104" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="300" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#0B0913" BorderBrush="#352044" BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top" Margin="8,15,8,0">
            <Button x:Name="HomeNavButton" Background="#29113A" BorderBrush="#B847FF" BorderThickness="1" Foreground="#F0D7FF"
                    Height="56" Padding="5" Margin="0,0,0,7" ToolTip="Inicio"
                    Click="HomeNavButton_Click">
              <StackPanel HorizontalAlignment="Center"><TextBlock Text="⌂" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="INICIO" FontSize="7" FontWeight="Bold" Margin="0,2,0,0"/></StackPanel>
            </Button>
            <Button x:Name="VersionNavButton" Background="Transparent" Foreground="#AEB4C2"
                    Height="56" Padding="5" Margin="0,0,0,7" ToolTip="Cambiar versión de Minecraft"
                    Click="VersionButton_Click">
              <StackPanel HorizontalAlignment="Center"><TextBlock Text="◇" FontSize="21" HorizontalAlignment="Center"/><TextBlock Text="VERSIONES" FontSize="7" FontWeight="Bold" Margin="0,2,0,0"/></StackPanel>
            </Button>
            <Button x:Name="FolderNavButton" Background="Transparent" Foreground="#AEB4C2"
                    Height="56" Padding="5" Margin="0,0,0,7" ToolTip="Abrir carpeta de esta versión"
                    Click="OpenFolderNavButton_Click">
              <StackPanel HorizontalAlignment="Center"><TextBlock Text="◎" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="CARPETA" FontSize="7" FontWeight="Bold" Margin="0,2,0,0"/></StackPanel>
            </Button>
            <Button x:Name="StatusNavButton" Background="Transparent" Foreground="#AEB4C2"
                    Height="56" Padding="5" Margin="0,0,0,7" ToolTip="Ver estado de instalación"
                    Click="StatusNavButton_Click">
              <StackPanel HorizontalAlignment="Center"><TextBlock Text="◉" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="ESTADO" FontSize="7" FontWeight="Bold" Margin="0,2,0,0"/></StackPanel>
            </Button>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,14">
            <Border Height="1" Background="#292D36" Margin="0,0,0,12" />
            <Button x:Name="SettingsNavButton" Background="Transparent" Foreground="#A3A9B5"
                    Height="56" Padding="4" ToolTip="Configuración"
                    Click="SettingsButton_Click">
              <StackPanel HorizontalAlignment="Center"><TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="AJUSTES" FontSize="7" FontWeight="Bold" Margin="0,2,0,0"/></StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <ScrollViewer x:Name="MainContentScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18,17,18,18">
          <Grid Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Bienvenido de nuevo, " FontSize="13" Foreground="#B9BFCC"
                         VerticalAlignment="Center" />
              <TextBlock x:Name="GreetingText" Text="jugador" FontSize="13" FontWeight="Bold"
                         Foreground="#F3F4F7" VerticalAlignment="Center" />
              <Ellipse Width="8" Height="8" Fill="{StaticResource MintBrush}"
                       VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" Fill="#40D89A" VerticalAlignment="Center" />
              <TextBlock Text=" KYVORA 26.2" FontSize="8" FontWeight="Bold"
                         Foreground="#BFC6D1" Margin="6,0,0,0" />
            </StackPanel>
          </Grid>

          <Border Height="270" CornerRadius="12" BorderBrush="#A43DE0" BorderThickness="1.5"
                  Background="#11101B" ClipToBounds="True">
            <Grid>
              <Image Source="xd/Kyvora-Galaxy.jpg" Stretch="UniformToFill" Opacity="0.7" />
              <Border>
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#EA0A0815" Offset="0" />
                    <GradientStop Color="#B20B0918" Offset="0.58" />
                    <GradientStop Color="#3A130A1C" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Grid Margin="23,20">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="195" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="HeroVersionText" Text="KYVORA PVP  /  CLIENTE PARA 1.8.9" FontSize="8"
                             FontWeight="Bold" Foreground="#E4AEFF" />
                  <TextBlock Text="Entra al juego." FontSize="28" FontWeight="Bold"
                             Margin="0,8,0,0" />
                  <TextBlock Text="Minecraft Java Edition · Cuenta premium"
                             FontSize="10" Foreground="#C2C7D0" Margin="0,5,0,0" />
                  <Button x:Name="PlayButton" Content="▶   JUGAR AHORA" Width="220" Height="52"
                          HorizontalAlignment="Left" Background="#C044FF" BorderBrush="#F0B9FF" BorderThickness="1.5"
                          Foreground="#101117" FontSize="14" FontWeight="Bold"
                          IsEnabled="False" Click="PlayButton_Click" Margin="0,20,0,0" />
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="VERSIÓN " FontSize="8" Foreground="#9DA4B1" />
                  <TextBlock x:Name="GameVersionDisplay" Text="1.8.9  ·  KYVORA HUD" FontSize="8" FontWeight="Bold"
                               Foreground="#D1D4DC" />
                  </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Width="158" Height="158" HorizontalAlignment="Center"
                        VerticalAlignment="Center" CornerRadius="18" Background="#080B14"
                        BorderBrush="#B847FF" BorderThickness="1.5" ClipToBounds="True">
                  <Image Source="xd/Kyvora-K.jpeg" Stretch="UniformToFill" />
                </Border>
              </Grid>
            </Grid>
          </Border>

          <Grid Margin="2,19,2,10">
            <TextBlock Text="TU EXPERIENCIA" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="KYVORA  /  PERFIL ACTIVO" FontSize="8" Foreground="#A0A7B4"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="3" Height="142" CornerRadius="10" Background="#171020"
                    BorderBrush="#8238A7" BorderThickness="1" ClipToBounds="True">
              <Grid>
                <Image Source="xd/Kyvora-Galaxy.jpg" Stretch="UniformToFill" Opacity="0.35" />
                <Border Background="#B00D0918" />
                <StackPanel VerticalAlignment="Center" Margin="17,0">
                  <TextBlock Text="INSTANCIA ACTIVA" FontSize="8" FontWeight="Bold" Foreground="#E2B0FF" />
                  <TextBlock x:Name="SelectedProfileText" Text="KYVORA PVP · 1.8.9" FontSize="16" FontWeight="Bold" Margin="0,7,0,0" />
                  <TextBlock x:Name="SelectedInstanceDetail" Text="Minecraft Java · cliente Kyvora" FontSize="9" Foreground="#B7BECC" Margin="0,4,0,0" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>

          <Grid Margin="0,13,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#130F1C" BorderBrush="#4A285F" BorderThickness="1"
                    CornerRadius="8" Padding="13">
              <StackPanel>
                <TextBlock Text="MEMORIA MÁXIMA" FontSize="8" FontWeight="Bold"
                           Foreground="#9199A8" />
                <Grid Margin="0,9,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="92" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="RAM del juego" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="Ajustada para dejar RAM libre al sistema" FontSize="8"
                               Foreground="#9AA3B2" Margin="0,3,0,0" />
                  </StackPanel>
                  <ComboBox x:Name="MemorySelector" Grid.Column="1"
                            SelectionChanged="MemorySelector_SelectionChanged">
                    <ComboBoxItem Content="1 GB" Tag="1024" IsSelected="True" />
                    <ComboBoxItem Content="1.5 GB" Tag="1536" />
                    <ComboBoxItem Content="2 GB" Tag="2048" />
                    <ComboBoxItem Content="3 GB" Tag="3072" />
                    <ComboBoxItem Content="4 GB" Tag="4096" />
                    <ComboBoxItem Content="5 GB" Tag="5120" />
                    <ComboBoxItem Content="6 GB" Tag="6144" />
                    <ComboBoxItem Content="8 GB" Tag="8192" />
                  </ComboBox>
                </Grid>
              </StackPanel>
            </Border>
            <Border x:Name="GameStatusPanel" Grid.Column="2" Background="#130F1C" BorderBrush="#4A285F"
                    BorderThickness="1" CornerRadius="8" Padding="13">
              <StackPanel>
                <TextBlock Text="ESTADO DEL JUEGO" FontSize="8" FontWeight="Bold"
                           Foreground="#9199A8" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Ellipse x:Name="StatusIndicator" Width="7" Height="7" Fill="#E7B95C"
                           VerticalAlignment="Center" />
                  <TextBlock x:Name="StatusText" Text="Configuración pendiente"
                             FontSize="9" FontWeight="SemiBold" Margin="7,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="StatusDetailText"
                           Text="Conecta tu cuenta Microsoft para verificar la licencia."
                           FontSize="8" Foreground="#9AA3B2" TextWrapping="Wrap"
                           Margin="0,5,0,0" />
                <ProgressBar x:Name="InstallProgress" Height="4" Minimum="0" Maximum="100"
                             Value="0" Visibility="Collapsed" Margin="0,8,0,0" />
                <TextBlock x:Name="ProgressText" FontSize="8" Foreground="#9AA3B2"
                           TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
              </StackPanel>
            </Border>
          </Grid>

          <Border Background="#100C17" BorderBrush="#49245E" BorderThickness="1"
                  CornerRadius="7" Padding="11" Margin="0,12,0,0">
            <DockPanel>
              <TextBlock Text="LAUNCHER" FontSize="8" FontWeight="Bold"
                         Foreground="#858D9B" VerticalAlignment="Top" Margin="0,2,12,0" />
              <TextBox x:Name="LogText" IsReadOnly="True" BorderThickness="0"
                       Background="Transparent" Foreground="#9AA3B2" FontFamily="Consolas"
                       FontSize="8" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                       MaxHeight="38" />
            </DockPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Column="2" Background="#0E0B16" BorderBrush="#352044"
              BorderThickness="1,0,0,0">
        <Grid Margin="17,15">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <Border Background="#1C1027" BorderBrush="#512B69" BorderThickness="1" CornerRadius="7" Padding="11,9">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="#40D89A" VerticalAlignment="Center" />
                <TextBlock Text="KYVORA CLIENT 26.2" FontSize="9" FontWeight="Bold"
                           Foreground="#D6D9E0" Margin="8,0,0,0" />
              </StackPanel>
            </Border>
          </Grid>
          <Grid Grid.Row="1" Margin="2,20,2,0">
            <TextBlock Text="Tu instalación" FontSize="14" FontWeight="Bold" />
            <TextBlock x:Name="SidebarVersionText" Text="Minecraft 1.8.9" FontSize="9" Foreground="#9BA2AF"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
          <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="4,0">
            <Border Width="84" Height="84" CornerRadius="42" Background="#181B24"
                    BorderBrush="#292E39" BorderThickness="1" HorizontalAlignment="Center">
              <TextBlock Text="✦" FontSize="30" Foreground="#4B4F5D"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Tu cliente, a tu manera" FontSize="11" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,16,0,0" />
            <TextBlock Text="Elige tu versión y ajusta la memoria antes de jugar."
                       FontSize="9" Foreground="#969EAC" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="8,7,8,0" />
          </StackPanel>
          <Border Grid.Row="3" Background="#171020" BorderBrush="#62307D" BorderThickness="1"
                  CornerRadius="7" Padding="11">
            <StackPanel>
              <TextBlock Text="CARPETA DE ESTA VERSIÓN" FontSize="8" FontWeight="Bold" Foreground="#8992A1" />
              <TextBlock x:Name="SidebarInstancePath" Text=".minecraft"
                         FontSize="9" TextWrapping="Wrap" Foreground="#D1D4DC"
                         Margin="0,7,0,0" />
              <TextBlock Text="Cada versión conserva sus propios archivos."
                         FontSize="8" Foreground="#929BAA" Margin="0,5,0,0" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>

