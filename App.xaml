<Application x:Class="KyvoraPvp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#090D15" />
    <SolidColorBrush x:Key="PanelBrush" Color="#111824" />
    <SolidColorBrush x:Key="PanelLightBrush" Color="#182333" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8997AA" />
    <SolidColorBrush x:Key="AccentBrush" Color="#BA48FF" />
    <SolidColorBrush x:Key="MintBrush" Color="#69E2CE" />
    <Style TargetType="Button">
      <EventSetter Event="ButtonBase.Click" Handler="OnButtonClick" />
      <Setter Property="Foreground" Value="#F5F6FA" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="#332642" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="16,11" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#C34DFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F5F6FA" />
      <Setter Property="Background" Value="#182333" />
      <Setter Property="BorderBrush" Value="#303D50" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
  </Application.Resources>
</Application>
